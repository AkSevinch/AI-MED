# AI MED backend configuration (example)
# Copy to .env and fill in real values.

# HTTP
PORT=5001
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
# Either set a full DSN:
DATABASE_URL=postgres://postgres:password@localhost:5432/medical_db?sslmode=disable
# ...or set the individual parts:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=medical_db
# DB_USER=postgres
# DB_PASSWORD=password
# DB_SSLMODE=disable

# Local storage for uploaded originals
UPLOAD_DIR=uploads

# AI provider: mock (default, демо без внешних ключей) | openrouter | gemini | anthropic.
# С mock ИИ-обзор и чат работают на встроенных демо-ответах без сетевых вызовов.
# С реальным провайдером ключи подключаются по наличию, остальные становятся
# резервом в порядке openrouter -> gemini -> anthropic.
#
# OpenRouter / любой OpenAI-совместимый API (Groq, GitHub Models, Together, ...).
# OPENAI_MODEL — список через запятую: модели перебираются по порядку.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
